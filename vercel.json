{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/gate.js", "use": "@vercel/node" },
    { "src": "api/track.js", "use": "@vercel/node" },
    { "src": "api/admin-data.js", "use": "@vercel/node" },
    { "src": "api/deploy-notify.js", "use": "@vercel/node" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ],
  "routes": [
    { "src": "/api/gate", "dest": "/api/gate.js" },
    { "src": "/api/track", "dest": "/api/track.js" },
    { "src": "/api/admin-data", "dest": "/api/admin-data.js" },
    { "src": "/api/deploy-notify", "dest": "/api/deploy-notify.js" },
    { "src": "/admin", "dest": "/public/admin.html" },
    { "src": "/privacy", "dest": "/public/privacy.html" },
    { "src": "/sitemap.xml", "dest": "/public/sitemap.xml" },
    { "src": "/robots.txt", "dest": "/public/robots.txt" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
